NODE_ENV=development
PORT=8000
# Development also allows localhost and private LAN origins on port 3000.
CORS_ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=debug
DATABASE_URL=postgresql://admin:admin@127.0.0.1:5432/ft_transcendence?sslmode=disable
JWT_ACCESS_SECRET=change_me_access_secret_minimum_32_characters
JWT_REFRESH_SECRET=change_me_refresh_secret_minimum_32_characters
JWT_ACCESS_TTL=24h
JWT_REFRESH_TTL=24h
BCRYPT_ROUNDS=10
