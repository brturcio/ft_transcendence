# Frontend environment variables
# Optional overrides. If unset, the frontend uses the host that opened the page.
# In production, connect to the backend with HTTPS and WSS only.
# Example:
# VITE_API_URL=https://api.example.com
# VITE_REALTIME_URL=wss://realtime.example.com
VITE_API_URL=http://localhost:8000
VITE_REALTIME_URL=ws://localhost:8001
